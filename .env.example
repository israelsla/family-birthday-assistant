SECRET_KEY=change-me
DATABASE_PATH=instance/family.db

# what time the daily birthday job (run_scheduler.py) fires, Asia/Jerusalem time
BIRTHDAY_JOB_HOUR=19
BIRTHDAY_JOB_MINUTE=0

# Green API (green-api.com) - sends the birthday greeting to the family WhatsApp
# group, via a dedicated WhatsApp number (not your personal one). Get these
# from your instance's dashboard after creating it and scanning the QR code.
GREEN_API_ID_INSTANCE=change-me
GREEN_API_TOKEN=change-me
# the family group's chatId, looks like 1203630XXXXXXXXXX@g.us - found via
# the getChats helper (tools/list_green_api_chats.py) once the instance is authorized
GREEN_API_GROUP_CHAT_ID=change-me
